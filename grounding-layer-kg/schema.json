{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goalc.ai/kg/grounding-layer/schema.json",
  "title": "The Grounding Layer Concept Graph",
  "description": "Canonical concept graph for the knowledge-graph-for-enterprise-AI category, published by ALC, Inc.",
  "type": "object",
  "$defs": {
    "ConceptNode": {
      "type": "object",
      "required": [
        "@id",
        "@type",
        "skos:prefLabel",
        "schema:description",
        "skos:inScheme"
      ],
      "properties": {
        "@id": {
          "type": "string"
        },
        "@type": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skos:prefLabel": {
          "type": "string"
        },
        "schema:description": {
          "type": "string",
          "minLength": 20
        },
        "skos:inScheme": {
          "type": "object"
        },
        "skos:broader": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "skos:narrower": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "skos:related": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "gci:contrastsWith": {
          "type": "object"
        },
        "gci:implementedBy": {
          "type": "object"
        }
      }
    },
    "SchemeNode": {
      "type": "object",
      "required": [
        "@id",
        "@type",
        "dcterms:title",
        "dcterms:license",
        "skos:hasTopConcept"
      ],
      "properties": {
        "@id": {
          "const": "scheme"
        },
        "@type": {
          "const": "skos:ConceptScheme"
        },
        "dcterms:title": {
          "type": "string"
        },
        "dcterms:license": {
          "type": "object"
        },
        "dcterms:creator": {
          "type": "string"
        },
        "skos:hasTopConcept": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "properties": {
    "@graph": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/SchemeNode"
          },
          {
            "$ref": "#/$defs/ConceptNode"
          }
        ]
      }
    }
  },
  "required": [
    "@context",
    "@graph"
  ]
}